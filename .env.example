# deploykey reads no secrets from the environment. Deploy keys are files under the
# inventory's key_dir (default ~/.ssh/deploy, 0600); never put key material here.
#
# Optional overrides (names only):
# DEPLOYKEY_CONFIG=/abs/path/to/deploy-keys.json   # runtime inventory (default ~/.ssh/deploy/deploy-keys.json)
# GH_BIN=/opt/homebrew/bin/gh                      # admin commands only (check policy, reconcile)
# GLAB_BIN=/opt/homebrew/bin/glab                  # admin commands only, GitLab hosts
